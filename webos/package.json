{
  "name": "nuvio-fork-webos",
  "version": "0.28.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "sync:defaults": "node scripts/sync-defaults.mjs",
    "build": "node scripts/sync-defaults.mjs --check && node scripts/build.mjs",
